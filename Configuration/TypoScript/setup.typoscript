# Rendering definition of the inlinefluid content elements.
#
# ExtensionUtility::configurePlugin() registers "tt_content.<ctype> =< lib.contentElement"
# for both content elements on all supported core versions. inlinefluid renders the raw
# markup an editor entered, so that definition is dropped with ">" and replaced by a plain
# USER_INT / USER object - this also keeps EXT:fluid_styled_content out of the dependencies.
#
# TYPO3\CMS\Extbase\Core\Bootstrap->run is available from v11 to v14 and is marked with
# #[AsAllowedCallable] on v14, so it passes the userFunc allow list there.

tt_content.inlinefluid_editor >
tt_content.inlinefluid_editor = USER_INT
tt_content.inlinefluid_editor {
    userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
    extensionName = Inlinefluid
    pluginName = Editor
}

tt_content.inlinefluid_editorcached >
tt_content.inlinefluid_editorcached = USER
tt_content.inlinefluid_editorcached {
    userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
    extensionName = Inlinefluid
    pluginName = EditorCached
}
